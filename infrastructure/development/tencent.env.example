# BFF (Tencent) Development environment — infrastructure/development/tencent.yml.
# Copy to tencent.env (in this same directory) and fill in real values.
# Never commit the real tencent.env file.
#
# This is NOT the production template (infrastructure/tencent/.env.example)
# and NOT bff/.env.example (the bare-host dev template) — it configures a
# local, Docker-based DEVELOPMENT stack for the BFF only: tsx watch
# (hot-reload), source bind-mounted. See
# docs/generated/PHASE-C-BFF-DEVELOPMENT-DOCKER-IMPLEMENTATION-REPORT.md.
#
# Deliberately named "tencent.env.example", not ".env.example" — this
# directory already has infrastructure/development/.env.example (Phase B,
# Office-scoped); this file is Tencent-scoped and must not collide with
# it (see the Phase C design audit report, Section 5/15).
#
# WAHA_API_KEY must never be sent to the browser.

PORT=8080
# WAHA remains external to this development stack (Phase C design
# report, Section 5) — point this at a real, already-running WAHA
# instance if you need the BFF's own health check / session routes to
# reach one.
WAHA_BASE_URL=
WAHA_API_KEY=
CORS_ALLOWED_ORIGIN=http://localhost:5173

# docs/generated/PHASE-6-FINAL-IMPLEMENTATION-CONTRACT.md Section 6: this
# v1 BFF is provisioned for exactly one WAHA session; must match the
# session name configured on the Office/backend side.
WAHA_SESSION_NAME=

# JWT verification (contract Section 4) — the BFF holds only the PUBLIC
# key (never the private one). PEM content directly, or the _PATH variant
# to read from a file. Must be the public half of whatever JWT_PRIVATE_KEY
# the Office development stack (infrastructure/development/.env, Phase B)
# uses.
# Example: JWT_PRIVATE_KEY_PATH=/run/secrets/wamora/jwt_private.pem
# Example: JWT_PUBLIC_KEY_PATH=/run/secrets/wamora/jwt_public.pem
JWT_KEYS_HOST_PATH=E:/keys/wamora
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=waha-monitoring-django
JWT_AUDIENCE=waha-monitoring-bff

# BFF -> Django internal endpoints (contract Section 8). This development
# stack deliberately does NOT share a Docker network with
# infrastructure/development/office.yml (Phase B) — BFF reaches Django's
# development container through its published host port instead, the
# same explicit-URL boundary production itself uses (NetBird/LAN there).
# On Docker Desktop (Windows/Mac), host.docker.internal resolves to the
# host machine; on native Linux Docker Engine it instead needs an
# explicit extra_hosts entry (not configured in tencent.yml — add it
# there if you need this on Linux). See the Phase C design/implementation
# reports for the full reasoning.
DJANGO_INTERNAL_BASE_URL=http://host.docker.internal:8000
# May be a separate, dev-only value from Office/production's own secret
# — it only needs to match the SAME value set in
# infrastructure/development/.env (Office stack, Phase B) for the two
# development containers to authenticate with each other. Never the
# production secret.
INTERNAL_SERVICE_KEY=
DJANGO_INTERNAL_TIMEOUT_MS=2000

WAHA_TIMEOUT_MS=10000

# Frontend (Phase D — docs/generated/PHASE-D-FRONTEND-DEVELOPMENT-DOCKER-IMPLEMENTATION-REPORT.md).
# Only VITE_-prefixed variables are exposed to the browser bundle — see
# frontend/.env.example and docs/06-SECURITY.md. Never a secret; these
# are the same host-published ports Phase B (Django, :8000) and this
# same file's own `bff` service (:8080) already publish — the browser
# calls them directly, never through Docker networking.
VITE_BFF_BASE_URL=http://localhost:8080
VITE_DJANGO_BASE_URL=http://localhost:8000
# Not a secret — must match WAHA_SESSION_NAME above. Left empty
# deliberately, matching frontend/.env.example's own convention.
VITE_WAHA_SESSION_NAME=
