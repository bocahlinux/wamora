# Office Development environment — infrastructure/development/office.yml.
# Copy to .env (in this same directory) and fill in real values. Never
# commit the real .env file.
#
# This is NOT the production template (infrastructure/office/.env.example)
# — it configures a local, Docker-based DEVELOPMENT stack: Django
# runserver + Celery worker + Celery beat + Redis, with the backend
# source bind-mounted for hot reload. See
# docs/generated/PHASE-B-DEVELOPMENT-DOCKER-IMPLEMENTATION-REPORT.md.

# Django
# Pre-filled (unlike every other empty field in this file) — confirmed
# by live Phase F testing that config/settings.py's own fallback
# (os.environ.get('DJANGO_SECRET_KEY', 'django-insecure-dev-only-placeholder'))
# does NOT apply here: Compose's env_file: mechanism sets this key to a
# literal empty string, which is present-but-empty, not absent — Python's
# os.environ.get(key, default) only uses `default` when `key` is
# genuinely missing, not when it's set to ''. An empty SECRET_KEY makes
# Django crash on the very first request (MessageMiddleware signs a
# cookie using it on every request, not just specific views) with
# "ImproperlyConfigured: The SECRET_KEY setting must not be empty." The
# value below is the exact same placeholder string settings.py's own
# fallback already uses — never used in production (infrastructure/office/.env.example
# requires a real one to be set explicitly).
DJANGO_SECRET_KEY=django-insecure-dev-only-placeholder
# Development convenience only. Production keeps this False
# (infrastructure/office/.env.example) and must never be True there (see
# settings.py's own "don't run with debug turned on in production!"
# warning).
DJANGO_DEBUG=True
# Left empty deliberately (fails closed, matching every other
# .env.example in this repository) — Django's own behavior: when
# DEBUG=True and this is empty, Django allows localhost/127.0.0.1/[::1]
# automatically, which is enough if you only ever reach this container
# directly from the host (e.g. `curl http://localhost:8000/...`).
#
# IMPORTANT, confirmed by live Phase E integration testing
# (docs/generated/PHASE-E-FULL-DEVELOPMENT-INTEGRATION-REPORT.md): the
# moment ANY value is set here, Django's empty-list DEBUG fallback above
# stops applying entirely — you must then list every hostname you need,
# not just add one. If you also run the Tencent development stack
# (infrastructure/development/tencent.yml, Phase C) so its BFF can reach
# this Django container via host.docker.internal:8000
# (DJANGO_INTERNAL_BASE_URL in tencent.env), Django will otherwise reject
# that request with DisallowedHost — use:
#   DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
# (all three — dropping localhost/127.0.0.1 here would break direct
# host-machine access, e.g. your own `curl`/browser calls to :8000).
DJANGO_ALLOWED_HOSTS=
DJANGO_LOG_LEVEL=INFO

# CORS (docs/generated/PHASE-7-CORS-FIX-REPORT.md) — comma-separated exact
# origin(s) allowed to make cross-origin browser requests to this API.
# Empty by default: fails closed, no origin permitted until set. Never a
# wildcard. Local dev example: http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Existing PostgreSQL (NOT a Docker service — see docs/13-FINAL-DEPLOYMENT-TOPOLOGY.md,
# docs/CLAUDE.md hard rule #1. This file intentionally does not define a
# postgres service). Point this at a real, already-reachable PostgreSQL
# instance: either a shared dev database, or one running on your own host
# machine outside Docker — on Docker Desktop (Windows/Mac), use
# host.docker.internal as DB_HOST to reach a host-installed PostgreSQL
# from inside this container (see the Phase B design report for why this
# project prefers an explicit host/URL here over a Docker-network
# shortcut; on native Linux Docker Engine, host.docker.internal instead
# needs an explicit extra_hosts entry — not configured in office.yml,
# add it there if you need this on Linux).
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Redis / Celery — this file's own `redis` service (internal Docker
# network name; not published to the host, see the Phase B reports for
# why).
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Django cache backend (Phase 12 — Security hardening) — backs DRF's
# cache-based request throttling (rate limiting). Reuses the SAME `redis`
# service as Celery above, on a different logical DB index (1, not
# Celery's 0) so cache keys never collide with the Celery broker/result
# data. No separate Redis service is created for this.
DJANGO_CACHE_REDIS_URL=redis://redis:6379/1

# How often (seconds) the periodic reconciliation task runs (Phase 5).
# Not specified by any doc — conservative default, tune as needed.
RECONCILIATION_INTERVAL_SECONDS=900

# Targeted-reconciliation trigger executor (docs/generated/INBOX-OUTBOUND-RECONCILIATION-IMPLEMENTATION-REPORT.md,
# docs/generated/PHASE-A-RECONCILIATION-EXECUTOR-IMPLEMENTATION-REPORT.md,
# docs/generated/PHASE-B-DEVELOPMENT-DOCKER-IMPLEMENTATION-REPORT.md).
# This development stack runs a real Celery worker + beat + Redis (this
# file's celery-worker/celery-beat/redis services) — 'celery' is the
# correct value here, exactly mirroring the same fix already applied to
# infrastructure/office/.env.example (Phase A). Deliberately explicit
# rather than relying on Django's own 'sync' default (config/settings.py).
RECONCILIATION_EXECUTOR=celery

# WAHA webhook authentication — must match the secret configured on the
# WAHA side's webhook HMAC config (unverified assumption; see
# docs/generated/PHASE-3-WEBHOOK-INGESTION.md)
WAHA_WEBHOOK_HMAC_SECRET=

# WAHA REST client (Phase 4 reconciliation) — same variable names as
# bff/.env.example for consistency. WAHA remains external to this
# development stack (Phase B design report, Section 11) — point this at
# a real, already-running WAHA instance if you need reconciliation to
# actually reach one.
WAHA_BASE_URL=
WAHA_API_KEY=

# JWT issuance (Phase 6 — docs/generated/PHASE-6-FINAL-IMPLEMENTATION-CONTRACT.md
# Section 4). Django holds the PRIVATE key only. Provide PEM content
# directly (newlines may be written as literal "\n"), or set the _PATH
# variant to read from a file instead. Never commit either.
# Example: JWT_PRIVATE_KEY_PATH=/run/secrets/wamora/jwt_private.pem
# Example: JWT_PUBLIC_KEY_PATH=/run/secrets/wamora/jwt_public.pem
JWT_KEYS_HOST_PATH=E:/keys/wamora
JWT_PRIVATE_KEY=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=
JWT_KID=default
JWT_ISSUER=waha-monitoring-django
JWT_AUDIENCE=waha-monitoring-bff
# Seconds — approved default is 8 hours (28800); see the contract Section 4.
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=28800

# BFF -> Django internal-endpoint authentication (contract Section 8) —
# only needed if you also run the Tencent development stack
# (infrastructure/development/tencent.yml, Phase C/D — BFF + frontend)
# against this backend. Must match INTERNAL_SERVICE_KEY in
# infrastructure/development/tencent.env exactly (see that file's own
# comment) — a dev-only shared value, unrelated to production's secret.
INTERNAL_SERVICE_KEY=

# OutboundOperation staleness/retry-eligibility threshold, seconds —
# approved default is 30 (contract Section 9).
OUTBOUND_OPERATION_STALE_SECONDS=30
