# Tencent VPS deployment environment.
# Copy to .env and fill in real values. Never commit the real .env file.

# WAHA
WAHA_API_KEY=

# BFF (also reads WAHA_API_KEY above via env_file)
PORT=8080
WAHA_BASE_URL=http://waha:3000
CORS_ALLOWED_ORIGIN=

# docs/generated/PHASE-6-FINAL-IMPLEMENTATION-CONTRACT.md Section 6.
WAHA_SESSION_NAME=

# JWT verification (contract Section 4) — public key only.
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=waha-monitoring-django
JWT_AUDIENCE=waha-monitoring-bff

# BFF -> Django internal endpoints (contract Section 8) — must match
# INTERNAL_SERVICE_KEY in infrastructure/office/.env.example.
DJANGO_INTERNAL_BASE_URL=
INTERNAL_SERVICE_KEY=
DJANGO_INTERNAL_TIMEOUT_MS=2000

WAHA_TIMEOUT_MS=10000
