# Tencent VPS deployment environment.
# Copy to .env and fill in real values. Never commit the real .env file.

# TLS / reverse proxy (Phase 14 Blocker B3, docker-compose.yml's
# reverse-proxy service) — all four REQUIRED, no defaults.
#
# PROXY_BIND_ADDRESS: same discipline as BFF_BIND_ADDRESS below — the
# VPS's private/NetBird interface address. This is now the ONE thing
# actually facing users (frontend/bff no longer publish their own
# ports), so this is the single address to firewall/security-group at
# the infrastructure layer.
PROXY_BIND_ADDRESS=
# TLS_CERT_PATH / TLS_KEY_PATH: absolute host paths to a REAL certificate
# (fullchain.pem) and private key (privkey.pem) — however they were
# obtained (Let's Encrypt, an internal CA, a purchased cert). NEVER a
# path inside this repository, and never commit either file. This repo
# does not decide, and must not guess, the domain or how the cert is
# issued (docs/11-DECISIONS-AND-OPEN-QUESTIONS.md "TLS/domain" is still
# open) — that decision belongs to whoever operates the real VPS.
TLS_CERT_PATH=
TLS_KEY_PATH=
# DJANGO_PROXY_UPSTREAM: host:port for the Office server's Django,
# reached over NetBird/LAN (same boundary DJANGO_INTERNAL_BASE_URL below
# already crosses in the opposite direction) — e.g. its NetBird address.
DJANGO_PROXY_UPSTREAM=

# Network isolation (Phase 14 Blocker B2, docker-compose.yml's bff
# service `ports:`) — REQUIRED, no default: the compose file refuses to
# start if this is unset. Must be the VPS's private/NetBird interface
# address (e.g. the address NetBird assigns on this host) — the address
# the BFF's published port 8080 will actually bind to. NEVER 0.0.0.0
# (binds every interface, including any public one) and NEVER a public
# IP. This does not replace a real firewall/security-group rule — it is
# the in-repo half of that same requirement (docs/06-SECURITY.md).
BFF_BIND_ADDRESS=

# Frontend build-time config (Phase 14 Blocker B1) — Vite bakes these into
# the static bundle at IMAGE BUILD time (docker-compose.yml's frontend
# service `build.args:`), not container start time — always set these
# before running `docker compose build frontend` / `up --build`, or the
# frontend ships with an empty/undefined API base URL. None of these three
# is a secret (base URLs + a session name) — never add WAHA_API_KEY or any
# other credential here; the frontend must never hold one (docs/06-SECURITY.md).
# Phase 14 Blocker B3: with reverse-proxy fronting everything on one
# origin (nginx/reverse-proxy.conf.template), set VITE_BFF_BASE_URL and
# VITE_DJANGO_BASE_URL to EMPTY STRINGS — frontend/src/lib/config.ts
# already does `${baseUrl}/api/...`, so '' yields a same-origin relative
# path with no code change needed. Only give either a real absolute URL
# for a setup with no reverse proxy in front (e.g. local testing).
VITE_BFF_BASE_URL=
VITE_DJANGO_BASE_URL=
VITE_WAHA_SESSION_NAME=

# WAHA
WAHA_API_KEY=

# BFF (also reads WAHA_API_KEY above via env_file)
PORT=8080
WAHA_BASE_URL=http://waha:3000
CORS_ALLOWED_ORIGIN=

# docs/generated/PHASE-6-FINAL-IMPLEMENTATION-CONTRACT.md Section 6.
WAHA_SESSION_NAME=

# JWT verification (contract Section 4) — public key only.
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=waha-monitoring-django
JWT_AUDIENCE=waha-monitoring-bff

# BFF -> Django internal endpoints (contract Section 8) — must match
# INTERNAL_SERVICE_KEY in infrastructure/office/.env.example.
DJANGO_INTERNAL_BASE_URL=
INTERNAL_SERVICE_KEY=
DJANGO_INTERNAL_TIMEOUT_MS=2000

WAHA_TIMEOUT_MS=10000

# Phase 12 (Security hardening) — general per-IP rate limit (requests per
# 60s window) applied to the frontend-JWT-gated /api routes. See
# bff/.env.example / bff/src/middleware/rateLimit.ts. A generous
# circuit-breaker default; tune down if needed.
RATE_LIMIT_MAX_PER_MINUTE=300

# Phase 14 Blocker B3 — opt-in, defaults to false. Deliberately LEFT
# false even with reverse-proxy running: BFF's own published port
# (BFF_BIND_ADDRESS above) stays directly reachable for Office/Celery's
# calls, which never go through the proxy — so there is no single
# "trusted hop" to point this at, and turning it on would let anyone who
# can reach that port spoof X-Forwarded-For and bypass the per-IP rate
# limit (bff/src/config.ts's own comment). Consequence to be aware of:
# with this left false, every browser request arriving via the proxy
# shows the proxy's own Docker-internal IP to the rate limiter, so
# middleware/rateLimit.ts's per-IP limit becomes an effectively shared
# limit across all proxied users, not truly per-client, until this is
# revisited (e.g. scoping trust to the Docker network's own subnet
# specifically, not done here — see the Phase 14 B3 report).
TRUST_PROXY=false

# Phase 14 MISSING item M4 (log rotation) — docker-compose.yml's
# `x-logging` anchor, applied to every service in this file. OPTIONAL:
# both already have sane universal defaults (10m/5 files) that need no
# production-specific value — only set these if you want to tune disk
# usage vs. retained log history.
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Phase 14 MISSING item M6 (rollback / image versioning) — the tag
# `frontend`/`bff` each build/run under (as two SEPARATE images —
# unlike Office's backend/celery-*, these are genuinely different
# apps). OPTIONAL — defaults to "local" if unset, no production value
# needed. Recommended convention: the current git commit's short SHA
# (`sh infrastructure/scripts/compute-image-tag.sh` prints exactly
# this, falling back to "local" itself if git isn't available). See
# docs/08-DEPLOYMENT.md's "Image versioning and rollback" section for
# the full procedure.
IMAGE_TAG=local
