# Environment files — never commit real secrets
.env
*/.env
**/.env
*.env
.env.*
!**/.env.example

# Node
node_modules/
dist/

# Python
__pycache__/
*.pyc
.venv/
venv/
db.sqlite3

# Celery beat's local schedule bookkeeping file — written into whatever
# directory `celery beat` runs from (backend/ when bind-mounted for
# Docker development, see infrastructure/development/office.yml); never
# meant to be committed, same as db.sqlite3 above.
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid

# OS
.DS_Store
Thumbs.db

# Editors / local tooling
.vscode/
.idea/
.pytest_cache/
.coverage
*.sqlite3-journal
