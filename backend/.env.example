# Backend (Office) environment variables.
# Copy to .env and fill in real values. Never commit the real .env file.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=
DJANGO_LOG_LEVEL=INFO

# CORS (docs/generated/PHASE-7-CORS-FIX-REPORT.md) — comma-separated exact
# origin(s) allowed to make cross-origin browser requests to this API
# (the frontend's login call, currently the only browser->Django path).
# Empty by default: fails closed, no origin permitted until set. Never a
# wildcard. Local dev example: http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Existing PostgreSQL (NOT a Docker service of this project — see docs/13-FINAL-DEPLOYMENT-TOPOLOGY.md)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Redis / Celery (Office Docker network)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# How often (seconds) the periodic reconciliation task runs (Phase 5).
# Not specified by any doc — conservative default, tune as needed.
RECONCILIATION_INTERVAL_SECONDS=900

# Targeted-reconciliation trigger executor (docs/generated/INBOX-OUTBOUND-RECONCILIATION-IMPLEMENTATION-REPORT.md).
# 'sync' (default): runs in-process, no Celery/Redis needed — use for
#   manual/local development. 'celery': enqueues onto the Celery/Redis
#   infrastructure above — use for the Office deployment, where a worker
#   is actually running. Any other value fails Django startup.
RECONCILIATION_EXECUTOR=sync

# WAHA webhook authentication — must match the secret configured on the
# WAHA side's webhook HMAC config (unverified assumption; see
# docs/generated/PHASE-3-WEBHOOK-INGESTION.md)
WAHA_WEBHOOK_HMAC_SECRET=

# WAHA REST client (Phase 4 reconciliation) — same variable names as
# bff/.env.example for consistency.
WAHA_BASE_URL=
WAHA_API_KEY=

# JWT issuance (Phase 6 — docs/generated/PHASE-6-FINAL-IMPLEMENTATION-CONTRACT.md
# Section 4). Django holds the PRIVATE key only. Provide PEM content
# directly (newlines may be written as literal "\n"), or set the _PATH
# variant to read from a file instead. Never commit either.
JWT_PRIVATE_KEY=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=
JWT_KID=default
JWT_ISSUER=waha-monitoring-django
JWT_AUDIENCE=waha-monitoring-bff
# Seconds — approved default is 8 hours (28800); see the contract Section 4.
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=28800

# BFF -> Django internal-endpoint authentication (contract Section 8) —
# must match the same value configured on the BFF side (bff/.env.example).
INTERNAL_SERVICE_KEY=

# OutboundOperation staleness/retry-eligibility threshold, seconds —
# approved default is 30 (contract Section 9).
OUTBOUND_OPERATION_STALE_SECONDS=30

# Phase 11 (Blast) limits — docs/11-DECISIONS-AND-OPEN-QUESTIONS.md item 12.
BLAST_MAX_RECIPIENTS_PER_CAMPAIGN=100
BLAST_MAX_RECIPIENTS_PER_SESSION_PER_DAY=500
BLAST_INTER_MESSAGE_DELAY_SECONDS=60

# Office/Celery -> Tencent/BFF internal dispatch endpoint (Phase 11).
# Distinct from INTERNAL_SERVICE_KEY above (that authenticates the
# OPPOSITE direction, BFF -> Django) — must match OFFICE_DISPATCH_SERVICE_KEY
# on the BFF side (bff/.env.example). Reaches the BFF over NetBird/LAN,
# same link DJANGO_INTERNAL_BASE_URL uses in reverse.
OFFICE_DISPATCH_SERVICE_KEY=
BFF_INTERNAL_BASE_URL=
BFF_INTERNAL_TIMEOUT_MS=10000
