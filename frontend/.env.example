# Frontend environment variables.
# Only VITE_-prefixed variables are exposed to the browser bundle.
# NEVER put WAHA API keys, DB credentials, or any other secret here —
# the frontend must only ever talk to the BFF (see docs/06-SECURITY.md).
#
# These example values (http://localhost:*) are for local/non-proxied
# use only. In production behind infrastructure/tencent/docker-compose.yml's
# reverse-proxy (Phase 14 Blocker B3), set both VITE_BFF_BASE_URL and
# VITE_DJANGO_BASE_URL to EMPTY STRINGS instead — src/lib/config.ts does
# `${baseUrl}/api/...`, so '' yields a same-origin relative path, which
# is what that proxy's single-hostname routing expects. See
# infrastructure/tencent/.env.example for the production values.

VITE_BFF_BASE_URL=http://localhost:8080

# Direct Django path (durable data / auth) — see docs/07-API-CONTRACT.md
# "Frontend -> Django" and the Phase 6 contract's login endpoint
# (docs/generated/PHASE-6-FINAL-IMPLEMENTATION-CONTRACT.md Section 4).
# Never put WAHA/Django *credentials* here — only the base URL, which is
# not a secret.
VITE_DJANGO_BASE_URL=http://localhost:8000

# Not a secret — the same session name configured as WAHA_SESSION_NAME on
# the BFF (bff/.env.example). The BFF's GET /api/sessions/:session/status
# route (docs/generated/PHASE-6-FINAL-IMPLEMENTATION-CONTRACT.md Section 2)
# requires the caller to already know the session name; there is no
# "list sessions" endpoint to discover it from.
VITE_WAHA_SESSION_NAME=
